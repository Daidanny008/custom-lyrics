{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "custom-lyrics song metadata",
  "type": "object",
  "required": [
    "id",
    "title",
    "original_languages",
    "tags"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Must equal the folder name."
    },
    "title": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      },
      "description": "Keyed by language code; every name the song is findable by."
    },
    "artist": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "romanized": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "description": "Optional - omit when the performer is unknown."
    },
    "album": {
      "type": "string"
    },
    "year": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2100
    },
    "original_languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Override a chip label, keyed by filename."
    },
    "order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Force chip order, by filename."
    },
    "notes": {
      "type": "string"
    },
    "artist_separator": {
      "type": "string",
      "maxLength": 3,
      "description": "How to join multiple artists. Default ' · ' means they performed together; ' / ' means separate recordings."
    },
    "section_languages": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[1-9][0-9]*$"
      },
      "additionalProperties": {
        "type": "string"
      },
      "description": "For a song that switches language mid-text: 1-based section number -> language code. Unlisted sections take the first original language."
    }
  }
}
